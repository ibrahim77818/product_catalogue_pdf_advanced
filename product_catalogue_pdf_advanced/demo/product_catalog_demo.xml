        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>
    <record id="demo_quant_organiser" model="stock.quant">
        <field name="product_id" model="product.product" eval="obj().env.ref('product_catalogue_pdf_advanced.demo_product_organiser').product_variant_ids[:1].id"/>
        <field name="inventory_quantity">75</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>
    <record id="demo_quant_divider" model="stock.quant">
        <field name="product_id" model="product.product" eval="obj().env.ref('product_catalogue_pdf_advanced.demo_product_divider').product_variant_ids[:1].id"/>
        <field name="inventory_quantity">40</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>
    <record id="demo_quant_laptopstand" model="stock.quant">
        <field name="product_id" model="product.product" eval="obj().env.ref('product_catalogue_pdf_advanced.demo_product_laptopstand').product_variant_ids[:1].id"/>
        <field name="inventory_quantity">3</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>
    <function model="stock.quant" name="action_apply_inventory">
        <function eval="[[('id', 'in', [ref('demo_quant_ergoflex'), ref('demo_quant_executive'), ref('demo_quant_stool'), ref('demo_quant_cantilever'), ref('demo_quant_sitstand'), ref('demo_quant_bench'), ref('demo_quant_walnut'), ref('demo_quant_pedestal'), ref('demo_quant_cabinet'), ref('demo_quant_filing'), ref('demo_quant_arc'), ref('demo_quant_pendant'), ref('demo_quant_lightbar'), ref('demo_quant_monitorarm'), ref('demo_quant_footrest'), ref('demo_quant_organiser'), ref('demo_quant_divider'), ref('demo_quant_laptopstand')])]]" model="stock.quant" name="search"/>
    </function>

    <!-- Pricelists: public, and a trade pricelist that shows its 12% discount.
         Odoo 17 has no product.list0 any more; the demo brings its own. -->
    <record id="demo_pricelist_public" model="product.pricelist">
        <field name="name">Public Price (Catalogue Demo)</field>
        <field name="sequence">5</field>
    </record>
    <record id="demo_pricelist_trade" model="product.pricelist">
        <field name="name">Trade Partners -12%</field>
        <field name="discount_policy">without_discount</field>
    </record>
    <record id="demo_pricelist_trade_rule" model="product.pricelist.item">
        <field name="pricelist_id" ref="demo_pricelist_trade"/>
        <field name="applied_on">3_global</field>
        <field name="compute_price">percentage</field>
        <field name="percent_price">12</field>
    </record>

    <!-- Customers: two trade customers and one on the public pricelist.
         Sending to all three produces two PDFs, one per pricelist. -->
    <record id="demo_partner_alrawabi" model="res.partner">
        <field name="name">Al Rawabi Contracting</field>
        <field name="email">buyer@alrawabi.example</field>
        <field name="is_company" eval="True"/>
        <field name="property_product_pricelist" ref="demo_pricelist_trade"/>
    </record>
    <record id="demo_partner_gulfdesign" model="res.partner">
        <field name="name">Gulf Design Studio</field>
        <field name="email">studio@gulfdesign.example</field>
        <field name="is_company" eval="True"/>
        <field name="property_product_pricelist" ref="demo_pricelist_trade"/>
    </record>
    <record id="demo_partner_walkin" model="res.partner">
        <field name="name">Walk-in Customer (Catalogue Demo)</field>
        <field name="email">walkin@example.com</field>
        <field name="is_company" eval="True"/>
        <field name="property_product_pricelist" ref="demo_pricelist_public"/>
    </record>

    <!-- Ready-to-print catalogues -->
    <record id="demo_catalog_collection" model="product.catalog">
        <field name="name">Office Collection 2027</field>
        <field name="catalog_type">general</field>
        <field name="cover_title">Office Collection 2027</field>
        <field name="cover_subtitle">Seating, desks, storage and lighting for modern workplaces</field>
        <field name="cover_image" type="base64" file="product_catalogue_pdf_advanced/static/img/demo/ergoflex.jpg"/>
        <field name="style">grid</field>
        <field name="columns">3</field>
        <field name="image_size">medium</field>
        <field name="show_toc" eval="True"/>
        <field name="show_stock" eval="True"/>
        <field name="show_link" eval="True"/>
        <field name="link_url_pattern">https://najd-interiors.example/p/{default_code}</field>
        <field name="categ_ids" eval="[(6, 0, [ref('demo_categ_root')])]"/>
        <field name="pricelist_id" ref="demo_pricelist_public"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="valid_until" eval="(DateTime.today() + relativedelta(months=6)).strftime('%Y-%m-%d')"/>
        <field name="notes">Prices subject to stock availability. Delivery within 10 working days.</field>
        <field name="lang">en_US</field>
    </record>
    <record id="demo_catalog_trade" model="product.catalog">
        <field name="name">Trade Catalogue</field>
        <field name="catalog_type">customer</field>
        <field name="cover_title">Trade Catalogue</field>
        <field name="cover_subtitle">Partner prices on our full range</field>
        <field name="style">grid</field>
        <field name="columns">4</field>
        <field name="image_size">small</field>
        <field name="accent_color">#0F766E</field>
        <field name="show_toc" eval="True"/>
        <field name="show_stock" eval="True"/>
        <field name="show_link" eval="True"/>
        <field name="link_url_pattern">https://najd-interiors.example/p/{default_code}</field>
        <field name="categ_ids" eval="[(6, 0, [ref('demo_categ_root')])]"/>
        <field name="pricelist_id" ref="demo_pricelist_trade"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
    </record>
    <record id="demo_catalog_price_list" model="product.catalog">
        <field name="name">Price List</field>
        <field name="catalog_type">internal</field>
        <field name="style">list</field>
        <field name="columns">1</field>
        <field name="image_size">small</field>
        <field name="accent_color">#7C3AED</field>
        <field name="show_cover" eval="False"/>
        <field name="show_stock" eval="True"/>
        <field name="categ_ids" eval="[(6, 0, [ref('demo_categ_root')])]"/>
        <field name="pricelist_id" ref="demo_pricelist_trade"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
    </record>
    <record id="demo_catalog_lookbook" model="product.catalog">
        <field name="name">New Arrivals Lookbook</field>
        <field name="catalog_type">promotion</field>
        <field name="cover_title">New Arrivals</field>
        <field name="cover_subtitle">This season's additions to the range</field>
        <field name="style">showcase</field>
        <field name="columns">2</field>
        <field name="image_size">medium</field>
        <field name="orientation">landscape</field>
        <field name="group_by_category" eval="False"/>
        <field name="accent_color">#B45309</field>
        <field name="tag_ids" eval="[(6, 0, [ref('demo_tag_new')])]"/>
        <field name="pricelist_id" ref="demo_pricelist_public"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="show_stock" eval="True"/>
    </record>
</odoo>
