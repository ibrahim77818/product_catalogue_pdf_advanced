    <!-- Ocean upholstery costs 120 more: the catalogue prints "From 1,450" -->
    <function model="product.template.attribute.value" name="write">
        <value model="product.template.attribute.value"
               search="[('product_tmpl_id', '=', ref('demo_product_ergoflex')), ('product_attribute_value_id', '=', ref('demo_attr_colour_ocean'))]"/>
        <value eval="{'price_extra': 120.0}"/>
    </function>

