<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            The PDF is attached by the send wizard (one per pricelist and
            language), so the template has no report_template. Its language
            follows the wizard's context.
        -->
        <record id="mail_template_product_catalog" model="mail.template">
            <field name="name">Product Catalogue: Send by email</field>
            <field name="model_id" ref="model_product_catalog"/>
            <field name="subject">{{ object.company_id.name }} – {{ object.cover_title or object.name }}</field>
            <field name="email_from">{{ (user.email_formatted or object.company_id.email_formatted) }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-size: 14px;">
    <p>Hello,</p>
    <p>
        Please find attached our latest catalogue,
        <strong t-out="object.cover_title or object.name or ''">Spring Collection</strong>.
    </p>
    <p t-if="object.valid_until">
        Prices are valid until <t t-out="format_date(object.valid_until) or ''">31/12/2026</t>.
    </p>
    <p>Our team is happy to help with quotations, availability or samples.</p>
    <p>
        Best regards,<br/>
        <t t-out="user.name or ''">Sales Team</t><br/>
        <t t-out="object.company_id.name or ''">My Company</t>
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>
