#. module: product_catalogue_pdf_advanced
#: model:mail.template,body_html:product_catalogue_pdf_advanced.mail_template_product_catalog
msgid ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\">\n"
"    <p>Hello,</p>\n"
"    <p>\n"
"        Please find attached our latest catalogue,\n"
"        <strong t-out=\"object.cover_title or object.name or ''\">Spring Collection</strong>.\n"
"    </p>\n"
"    <p t-if=\"object.valid_until\">\n"
"        Prices are valid until <t t-out=\"format_date(object.valid_until) or ''\">31/12/2026</t>.\n"
"    </p>\n"
"    <p>Our team is happy to help with quotations, availability or samples.</p>\n"
"    <p>\n"
"        Best regards,<br/>\n"
"        <t t-out=\"user.name or ''\">Sales Team</t><br/>\n"
"        <t t-out=\"object.company_id.name or ''\">My Company</t>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-size: 14px;\" dir=\"rtl\">\n"
"    <p>مرحبًا،</p>\n"
"    <p>\n"
"        تجدون مرفقًا أحدث كتالوج لدينا،\n"
"        <strong t-out=\"object.cover_title or object.name or ''\">Spring Collection</strong>.\n"
"    </p>\n"
"    <p t-if=\"object.valid_until\">\n"
"        الأسعار صالحة حتى <t t-out=\"format_date(object.valid_until) or ''\">31/12/2026</t>.\n"
"    </p>\n"
"    <p>يسعد فريقنا مساعدتكم في عروض الأسعار والتوفر والعينات.</p>\n"
"    <p>\n"
"        مع أطيب التحيات،<br/>\n"
"        <t t-out=\"user.name or ''\">Sales Team</t><br/>\n"
"        <t t-out=\"object.company_id.name or ''\">My Company</t>\n"
"    </p>\n"
"</div>"

